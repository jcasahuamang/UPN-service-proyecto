     $V{v_mes_pago}.equals("03") ? "Marzo" : 
     $V{v_mes_pago}.equals("04") ? "Abril" : 
     $V{v_mes_pago}.equals("05") ? "Mayo" : 
     $V{v_mes_pago}.equals("06") ? "Junio" : 
     $V{v_mes_pago}.equals("07") ? "Julio" : 
     $V{v_mes_pago}.equals("08") ? "Agosto" : 
     $V{v_mes_pago}.equals("09") ? "Setiembre" : 
     $V{v_mes_pago}.equals("10") ? "Octubre" : 
     $V{v_mes_pago}.equals("11") ? "Noviembre" : 
     $V{v_mes_pago}.equals("12") ? "Diciembre" : 
     "")+" de "+$V{v_ano_pago}]]></textFieldExpression>
