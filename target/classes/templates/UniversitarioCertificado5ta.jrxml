	<variable name="v_sum_imp_resultado" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{c_imp_resultado}]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="v_cc_imp_bruta_anual" class="java.lang.Double">
		<variableExpression><![CDATA[$V{v_sum_imp_resultado} + ($F{c_imp_resul_liq} != null ?  $F{c_imp_resul_liq} : 0) + ($F{c_retencion_cia_actual} != null ?  $F{c_retencion_cia_actual} : 0)]]></variableExpression>
	</variable>
	<variable name="v_c_deduccion" class="java.lang.Double">
		<variableExpression><![CDATA[$F{c_imp_valor_iut} * $F{num_uit_deducible}]]></variableExpression>
	</variable>
	<variable name="v_renta_imponible" class="java.lang.Double">
		<variableExpression><![CDATA[$F{nodomiciliado}>0? $V{v_cc_imp_bruta_anual} :(
	($V{v_cc_imp_bruta_anual} - $V{v_c_deduccion})>0 ? ($V{v_cc_imp_bruta_anual} - $V{v_c_deduccion}) :0
)]]></variableExpression>
	</variable>
	<variable name="v_retenido_empresa" class="java.lang.Double">
		<variableExpression><![CDATA[($F{c_sum_imp_retencion} != null ?  $F{c_sum_imp_retencion} : 0) +
($F{c_imp_retencion_liq} != null ?  $F{c_imp_retencion_liq} : 0) -
($F{c_imp_dev_retencion} != null ?  $F{c_imp_dev_retencion} : 0) +
($F{c_sum_imp_retencion_ma} != null ?  $F{c_sum_imp_retencion_ma} : 0)]]></variableExpression>
	</variable>
	<variable name="v_retenido_otros" class="java.lang.Double">
		<variableExpression><![CDATA[($F{tot_reten_cia_emp} != null ?  $F{tot_reten_cia_emp} : 0) +
($F{c_tot_imp_retenido_otras} != null ?  $F{c_tot_imp_retenido_otras} : 0)]]></variableExpression>
	</variable>
	<variable name="v_tramo1_imp" class="java.lang.Double">
		<variableExpression><![CDATA[($F{tope_1} < $V{v_cc_imp_bruta_anual}?  ( ( $F{c_monto_1} *  $F{c_porc_1} )/100 )   : ( ( $V{v_renta_imponible} *  $F{c_porc_1} )/100 ))]]></variableExpression>
	</variable>
	<variable name="v_tramo2_imp" class="java.lang.Double">
		<variableExpression><![CDATA[( ($V{v_cc_imp_bruta_anual} < $F{tope_2})  && ( $V{v_cc_imp_bruta_anual} > $F{tope_1} ) ? 
   ( ($V{v_cc_imp_bruta_anual} - $F{tope_1}) * $F{c_porc_2} / 100 ) :
   ($V{v_cc_imp_bruta_anual} > $F{tope_2} ? ( ($F{c_monto_2} - $F{c_monto_1} ) * $F{c_porc_2}) /100 : 0.00  )  
)]]></variableExpression>
	</variable>
	<variable name="v_tramo3_imp" class="java.lang.Double">
		<variableExpression><![CDATA[( ($V{v_cc_imp_bruta_anual} < $F{tope_3})  && ( $V{v_cc_imp_bruta_anual} > $F{tope_2} ) ? 
   ( ($V{v_cc_imp_bruta_anual} - $F{tope_2}) * $F{c_porc_3} / 100 ) :
   ($V{v_cc_imp_bruta_anual} > $F{tope_3} ? ( ($F{c_monto_3} - $F{c_monto_2} ) * $F{c_porc_3}) /100 : 0.00  )  
)]]></variableExpression>
	</variable>
	<variable name="v_tramo4_imp" class="java.lang.Double">
		<variableExpression><![CDATA[( ($V{v_cc_imp_bruta_anual} < $F{tope_4})  && ( $V{v_cc_imp_bruta_anual} > $F{tope_3} ) ? 
   ( ($V{v_cc_imp_bruta_anual} - $F{tope_3}) * $F{c_porc_4} / 100 ) :
   ($V{v_cc_imp_bruta_anual} > $F{tope_4} ? ( ($F{c_monto_4} - $F{c_monto_3} ) * $F{c_porc_4}) /100 : 0.00  )  
)]]></variableExpression>
	</variable>
	<variable name="v_tramo5_imp" class="java.lang.Double">
		<variableExpression><![CDATA[( $V{v_cc_imp_bruta_anual} > $F{tope_4} ? 
   ( ($V{v_cc_imp_bruta_anual} - $F{tope_4}) * $F{c_porc_5} / 100 ) : 0.00  
)]]></variableExpression>
	</variable>
