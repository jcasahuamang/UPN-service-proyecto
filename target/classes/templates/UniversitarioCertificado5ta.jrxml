				</textElement>
				<textFieldExpression><![CDATA[$F{c_des_empresa}+ ",  con  RUC.  Nº.  " +  $F{c_ruc_empresa} + ", domiciliado (Domicilio Fiscal ) en "+ ($F{c_des_direccion}  != null ? $F{c_des_direccion} :"")  + " San Isidro, certifica :"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="49" y="174" width="440" height="30" uuid="e593653f-f524-4844-9727-311fd54490e3">
